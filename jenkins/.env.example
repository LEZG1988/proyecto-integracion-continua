# Copia este archivo como jenkins/.env y cambia los valores. El .env NO se sube al repositorio.
# Usuario administrador de Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambia_esta_clave
# Credenciales de PostgreSQL que Jenkins guarda y entrega al pipeline
POSTGRES_USER=usuario
POSTGRES_PASSWORD=cambia_esta_clave
